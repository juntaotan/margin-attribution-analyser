DB_URL=jdbc:postgresql://localhost:5432/your_database_name
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# Application data lake (the MinIO service in compose.yaml by default)
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_ENDPOINT=http://localhost:9000
MINIO_RAW_BUCKET=margin-raw

# PostgreSQL backup repository (an independent remote MinIO/S3 service)
# Keep this endpoint and its storage on a different host from PostgreSQL in production.
# pgBackRest expects a hostname/IP without an http:// or https:// scheme.
BACKUP_STANZA=margin-prod
BACKUP_S3_ENDPOINT=backup.example.com
BACKUP_S3_PORT=443
BACKUP_S3_BUCKET=margin-postgres-backup
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=your_backup_access_key
BACKUP_S3_SECRET_KEY=your_backup_secret_key
BACKUP_S3_URI_STYLE=path
BACKUP_S3_TLS_VERIFY=y
BACKUP_S3_REPOSITORY_PATH=/production/margin-attribution
BACKUP_REPOSITORY_CIPHER_PASS=replace_with_a_long_random_passphrase
BACKUP_RETENTION_DAYS=28

# Automated backup schedule. Day of week uses ISO numbering: Monday=1, Sunday=7.
BACKUP_SCHEDULE_TIME_ZONE=Pacific/Auckland
BACKUP_FULL_DAY_OF_WEEK=7
BACKUP_FULL_TIME=02:00
BACKUP_DIFF_TIME=02:00
