# Copy this file to .env.deploy before starting the deployment stack.
APP_PORT=18080
# Backend host mode: cpu, cuda (Linux CDI), or cuda-desktop (Windows Docker Desktop/WSL2).
BACKEND_RUNTIME=cpu
DB_USERNAME=margin
DB_PASSWORD=
MINIO_ACCESS_KEY=margin-minio
# Required: MinIO root password, at least 8 characters.
MINIO_SECRET_KEY=
MINIO_RAW_BUCKET=margin-raw
MINIO_REPORT_BUCKET=margin-reports
LLAMA_BASE_URL=http://host.docker.internal:8081
LLAMA_MODEL=local
ONLYOFFICE_PORT=18082
ONLYOFFICE_PUBLIC_URL=http://localhost:18082
# Required: shared signing key for the backend and ONLYOFFICE, e.g. the output of `openssl rand -hex 32`.
ONLYOFFICE_JWT_SECRET=
