# Optional accelerator images. Build context: backend. The existing Dockerfile remains CPU-only.
ARG CUDA_BUILD_IMAGE=nvidia/cuda:12.8.1-devel-ubuntu24.04
ARG CUDA_RUNTIME_IMAGE=nvidia/cuda:12.8.1-runtime-ubuntu24.04
FROM maven:3.9-eclipse-temurin-21 AS java-build
WORKDIR /workspace
COPY pom.xml ./
RUN mvn --batch-mode --no-transfer-progress dependency:go-offline
COPY src ./src
RUN mvn --batch-mode --no-transfer-progress -Dmaven.test.skip=true package

FROM eclipse-temurin:21-jdk-noble AS opencl-build
RUN apt-get update && apt-get install -y --no-install-recommends cmake g++ make ocl-icd-opencl-dev opencl-clhpp-headers \
    && rm -rf /var/lib/apt/lists/*
COPY src/main/resources /src
RUN cmake -S /src/native -B /build -DMARGIN_CUDA=OFF -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /build --target margintrace_opencl -j 4 \
    && cmake --install /build --prefix /native

FROM eclipse-temurin:21-jre-noble AS opencl
RUN apt-get update && apt-get install -y --no-install-recommends ocl-icd-libopencl1 python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=java-build /workspace/target/*.jar app.jar
COPY --from=opencl-build /native /opt/margintrace/native
ENV MARGIN_NATIVE_LIBRARY_DIR=/opt/margintrace/native MARGIN_OPENCL_KERNEL_DIR=/opt/margintrace/native
EXPOSE 8090
ENTRYPOINT ["java", "-jar", "/app/app.jar"]

FROM ${CUDA_BUILD_IMAGE} AS cuda-build
RUN apt-get update && apt-get install -y --no-install-recommends cmake g++ make ocl-icd-opencl-dev opencl-clhpp-headers \
    && rm -rf /var/lib/apt/lists/*
COPY --from=java-build /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
COPY src/main/resources /src
# Retain portable PTX; override for the intended toolkit/device when needed.
ARG CUDA_ARCHITECTURES=75
RUN cmake -S /src/native -B /build -DMARGIN_CUDA=ON -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCHITECTURES} \
    && cmake --build /build --target margintrace_cuda margintrace_opencl -j 4 \
    && cmake --install /build --prefix /native

FROM ${CUDA_RUNTIME_IMAGE} AS cuda
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-21-jre-headless ocl-icd-libopencl1 python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=java-build /workspace/target/*.jar app.jar
COPY --from=cuda-build /native /opt/margintrace/native
ENV MARGIN_NATIVE_LIBRARY_DIR=/opt/margintrace/native MARGIN_OPENCL_KERNEL_DIR=/opt/margintrace/native
EXPOSE 8090
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
